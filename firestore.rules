rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'admin';
    }

    match /users/{uid} {
      // isAdmin() reads request.auth.uid's OWN document via get(), which
      // is an internal lookup that bypasses this same rule (Firestore
      // rules don't recurse into themselves for that) rather than a
      // second client-facing read of some other uid — so this stays
      // well-defined and doesn't grant anyone read access to themselves
      // that they wouldn't already have.
      allow read: if isOwner(uid) || isAdmin();

      // A brand-new account may never arrive with a role already set.
      allow create: if isOwner(uid) && !('role' in request.resource.data);

      // The owner may touch every field except "role", which must stay
      // exactly what it already was (closes the same self-promotion gap
      // as before). An admin gets the narrow opposite: allowed to change
      // ONLY "role" on any account (including stepping themselves down) —
      // not a blank check to rewrite someone else's nickname, avatar or
      // checklist progress, which stays the owner's alone to change.
      allow update: if (isOwner(uid) &&
        request.resource.data.get('role', null) == resource.data.get('role', null)) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));

      allow delete: if false;
    }

    match /gameData/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anything not explicitly listed above is closed by default.
  }
}
