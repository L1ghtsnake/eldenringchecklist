rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'admin';
    }

    match /users/{uid} {
      // isAdmin() reads request.auth.uid's OWN document via get(), which
      // is an internal lookup that bypasses this same rule (Firestore
      // rules don't recurse into themselves for that) rather than a
      // second client-facing read of some other uid — so this stays
      // well-defined and doesn't grant anyone read access to themselves
      // that they wouldn't already have.
      allow read: if isOwner(uid) || isAdmin();

      // A brand-new account may never arrive with a role already set.
      allow create: if isOwner(uid) && !('role' in request.resource.data);

      // The owner may touch every field except "role", which must stay
      // exactly what it already was (closes the same self-promotion gap
      // as before). An admin gets the narrow opposite: allowed to change
      // ONLY "role" on any account (including stepping themselves down) —
      // not a blank check to rewrite someone else's nickname, avatar or
      // checklist progress, which stays the owner's alone to change.
      allow update: if (isOwner(uid) &&
        request.resource.data.get('role', null) == resource.data.get('role', null)) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));

      allow delete: if false;
    }

    match /gameData/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Boss-guide comments. Public/guest read (so a signed-out visitor can
    // still see the discussion), but only a signed-in account can post,
    // and only as themselves — the fields below are exactly what
    // wiki-boss.js's handleCommentSubmit() writes. Comments aren't
    // editable once posted (no update rule at all), only deletable by
    // their own author or an admin — same isOwner/isAdmin split already
    // used for users/{uid}.
    match /comments/{commentId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.bossId is string && request.resource.data.bossId.size() > 0 &&
        request.resource.data.game is string &&
        request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
        request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // Anything not explicitly listed above is closed by default.
  }
}
